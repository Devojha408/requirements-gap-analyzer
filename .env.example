# Requirements Gap Analyzer — environment configuration
# Copy to .env and fill in your values. .env is gitignored; never commit real keys.

# Base URL of your Langflow deployment (e.g. DataStax Langflow or self-hosted)
LANGFLOW_BASE_URL=https://api.langflow.astra.datastax.com

# Flow ID of the main analysis flow (from the Langflow UI)
MAIN_ANALYSIS_FLOW_ID=your-flow-id-here

# Langflow API key (Settings -> API Keys in Langflow)
API_KEY=your-langflow-api-key

# Server port (optional, defaults to 3000)
PORT=3000
